{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "rarity": {
      "type": "integer",
      "minimum": 4,
      "maximum": 5
    },
    "element": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "weaponType": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "region": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female"
      ]
    },
    "bodyType": {
      "type": "string",
      "enum": [
        "short",
        "medium",
        "tall"
      ]
    },
    "birthday": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
        },
        {
          "type": "null"
        }
      ]
    },
    "releaseDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "releaseVersion": {
      "type": "string",
      "minLength": 1
    },
    "ascensionStat": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "materials": {
      "type": "object",
      "properties": {
        "boss": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "weeklyBoss": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "localSpecialty": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "talent": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "common": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        }
      },
      "required": [
        "boss",
        "weeklyBoss",
        "localSpecialty",
        "talent",
        "common"
      ],
      "additionalProperties": false
    },
    "constellations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "meaning": {
            "type": "string"
          },
          "releaseVersion": {
            "type": "string",
            "minLength": 1
          },
          "images": {
            "type": "object",
            "properties": {
              "image": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9/_.-]*\\.(webp|png|svg|jpg)$"
              }
            },
            "additionalProperties": false
          },
          "levels": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "level": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 6
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                },
                "images": {
                  "type": "object",
                  "properties": {
                    "icon": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9/_.-]*\\.(webp|png|svg|jpg)$"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "level",
                "name",
                "description",
                "images"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "meaning",
          "releaseVersion",
          "images",
          "levels"
        ],
        "additionalProperties": false
      }
    },
    "images": {
      "type": "object",
      "properties": {
        "icon": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9/_.-]*\\.(webp|png|svg|jpg)$"
        },
        "card": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9/_.-]*\\.(webp|png|svg|jpg)$"
        },
        "inGame": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9/_.-]*\\.(webp|png|svg|jpg)$"
        },
        "wish": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9/_.-]*\\.(webp|png|svg|jpg)$"
        },
        "multiWish": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9/_.-]*\\.(webp|png|svg|jpg)$"
        },
        "partyIcon": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9/_.-]*\\.(webp|png|svg|jpg)$"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "slug",
    "name",
    "rarity",
    "element",
    "weaponType",
    "region",
    "gender",
    "bodyType",
    "birthday",
    "releaseDate",
    "releaseVersion",
    "ascensionStat",
    "materials",
    "constellations",
    "images"
  ],
  "additionalProperties": false
}
