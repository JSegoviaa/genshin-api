{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "source": {
      "type": "string",
      "enum": [
        "general-enemy-drops",
        "elite-enemy-drops",
        "normal-boss-drops",
        "weekly-boss-drops",
        "ascension-gems",
        "domains-of-forgery"
      ]
    },
    "images": {
      "type": "object",
      "properties": {
        "icon": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9/_.-]*\\.(webp|png|svg|jpg)$"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "slug",
    "name",
    "type",
    "source",
    "images"
  ],
  "additionalProperties": false
}
