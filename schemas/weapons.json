{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "rarity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "weaponType": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "secondaryStat": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "series": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ascensionMaterial": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "releaseVersion": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "images": {
      "type": "object",
      "properties": {
        "icon": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9/_.-]*\\.(webp|png|svg|jpg)$"
        },
        "awakenedIcon": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9/_.-]*\\.(webp|png|svg|jpg)$"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "slug",
    "name",
    "rarity",
    "weaponType",
    "secondaryStat",
    "series",
    "ascensionMaterial",
    "releaseVersion",
    "images"
  ],
  "additionalProperties": false
}
