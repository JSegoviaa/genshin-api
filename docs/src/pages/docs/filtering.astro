---
import Docs from "../../layouts/Docs.astro";
import Callout from "../../components/Callout.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import TryIt from "../../components/TryIt.astro";
import { API_PREFIX, allResources, example } from "../../lib/api";

const resources = allResources().filter((r) => r.filters.length);
const filterPath = `${API_PREFIX}/characters?element=pyro,hydro&rarity=5&limit=2`;
const filterExample = await example(filterPath);
---

<Docs
  title="Filtering & Sorting"
  description="Narrow down lists and random draws with filters, search by name, and choose the order of results."
>
  <h2 id="filters">Filters</h2>
  <p>
    Filters are query parameters. Combine as many as you like: an item must match
    all of them. Separate several values with commas to match any of them.
  </p>
  <CodeBlock lang="text" title="Pyro or Hydro characters with 5 stars" code={filterPath} />
  <CodeBlock title={`GET ${filterPath}`} code={filterExample} />

  <p>
    Values are matched by slug, so they are case and space insensitive:
    <code>region=Liyue</code> and <code>region=liyue</code> are equivalent.
  </p>

  <h2 id="name">Search by name</h2>
  <p>
    Every list accepts <code>name</code> for a partial match. For example,
    <code>?name=hu</code> matches Hu Tao.
  </p>

  <h2 id="available-filters">Available filters</h2>
  {
    resources.map((r) => (
      <>
        <h3 id={`filters-${r.name}`}>
          <a href={`/docs/resources/${r.name}/`}>{r.title}</a>
        </h3>
        <table class="frame">
          <thead>
            <tr><th>Parameter</th><th>Description</th></tr>
          </thead>
          <tbody>
            {r.filters.map((f) => (
              <tr>
                <td><code>{f.name}</code></td>
                <td class="muted">{f.description}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </>
    ))
  }

  <h2 id="sorting">Sorting</h2>
  <p>
    Use <code>sort</code> with a field name. Prefix it with <code>-</code> for
    descending order. Every resource can be sorted by <code>id</code> (default)
    and <code>name</code>; some add more fields, listed on each resource page.
  </p>
  <CodeBlock lang="text" title="Newest characters first" code={`${API_PREFIX}/characters?sort=-releaseDate`} />

  <h2 id="random">Random with filters</h2>
  <p>
    The <code>/random</code> endpoint accepts the same filters and
    <code>name</code>, which is handy for games and quizzes:
  </p>
  <TryIt path={`${API_PREFIX}/characters/random?region=liyue&rarity=4`} />

  <Callout title="Unknown parameters" tone="warning">
    <p>
      A misspelled parameter such as <code>?elemnt=pyro</code> returns
      <code>400 Bad Request</code> listing the allowed parameters, instead of
      being silently ignored.
    </p>
  </Callout>
</Docs>
