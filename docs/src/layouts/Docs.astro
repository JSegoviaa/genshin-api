---
import Base from "./Base.astro";
import { navigation } from "../lib/nav";

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
}

const { title, description, eyebrow } = Astro.props;
const path = Astro.url.pathname.replace(/\/?$/, "/");
const flat = navigation.flatMap((g) => g.items);
const index = flat.findIndex((i) => i.href === path);
const prev = index > 0 ? flat[index - 1] : undefined;
const next = index >= 0 && index < flat.length - 1 ? flat[index + 1] : undefined;
const currentGroup = navigation.find((g) => g.items.some((i) => i.href === path));
---

<Base title={title} description={description}>
  <div class="layout">
    <aside class="sidebar">
      <details open>
        <summary>Menu</summary>
        <nav>
          {
            navigation.map((group) => (
              <div class="group">
                <p class="group-title">{group.title}</p>
                <ul>
                  {group.items.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        class:list={{ active: item.href === path }}
                        aria-current={item.href === path ? "page" : undefined}
                      >
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </details>
      <script is:inline>
        if (matchMedia("(max-width: 900px)").matches)
          document.querySelector(".sidebar details")?.removeAttribute("open");
      </script>
    </aside>

    <main class="content">
      <span class="eyebrow">{eyebrow ?? currentGroup?.title}</span>
      <h1>{title}</h1>
      {description && <p class="lead">{description}</p>}
      <div class="divider" aria-hidden="true"></div>
      <slot />

      <nav class="pager">
        {
          prev ? (
            <a href={prev.href} class="frame prev">
              <span>Previous</span>
              {prev.label}
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a href={next.href} class="frame next">
              <span>Next</span>
              {next.label}
            </a>
          )
        }
      </nav>
    </main>
  </div>
</Base>

<style>
  .layout {
    max-width: var(--content-w);
    margin: 0 auto;
    padding: 2.5rem 1.5rem 0;
    display: grid;
    grid-template-columns: 230px minmax(0, 1fr);
    gap: 3.5rem;
  }
  .sidebar details {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }
  .sidebar summary {
    display: none;
  }
  .group + .group {
    margin-top: 1.8rem;
  }
  .group-title {
    display: flex;
    align-items: center;
    gap: 0.55em;
    margin: 0 0 0.6rem;
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .group-title::before {
    content: "";
    width: 9px;
    height: 9px;
    background: var(--gold);
    clip-path: polygon(50% 0, 62% 38%, 100% 50%, 62% 62%, 50% 100%, 38% 62%, 0 50%, 38% 38%);
  }
  .group-title::after {
    content: "";
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--border-strong), transparent);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  li a {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.36rem 0.9rem;
    border-radius: 999px;
    font-size: 0.93rem;
    color: var(--muted);
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }
  li a::before {
    content: "";
    flex: none;
    width: 6px;
    height: 6px;
    rotate: 45deg;
    border: 1px solid currentColor;
    opacity: 0.5;
  }
  li a:hover {
    color: var(--cream);
    background: rgba(236, 229, 216, 0.07);
  }
  li a.active {
    color: var(--ink);
    font-weight: 600;
    background: var(--cream);
    box-shadow: 0 0 14px rgba(236, 229, 216, 0.22);
  }
  li a.active::before {
    opacity: 1;
    background: var(--ink);
    border-color: var(--ink);
  }
  .content {
    min-width: 0;
    max-width: 820px;
  }
  .lead {
    font-size: 1.12rem;
    color: var(--muted);
  }
  .divider {
    position: relative;
    height: 1px;
    margin: 1.8rem 0 2.2rem;
    background: linear-gradient(90deg, var(--gold-deep), transparent 70%);
  }
  .divider::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 12px;
    height: 12px;
    translate: 0 -50%;
    background: var(--gold-bright);
    clip-path: polygon(50% 0, 62% 38%, 100% 50%, 62% 62%, 50% 100%, 38% 62%, 0 50%, 38% 38%);
    filter: drop-shadow(0 0 6px rgba(243, 226, 179, 0.8));
  }
  .content :global(h2) {
    display: flex;
    align-items: center;
    gap: 0.6em;
  }
  .content :global(h2)::before {
    content: "";
    flex: none;
    width: 0.5em;
    height: 0.5em;
    rotate: 45deg;
    border: 2px solid var(--gold);
    background: linear-gradient(var(--gold), var(--gold)) center / 40% 40% no-repeat;
  }
  .content :global(h2)::after {
    content: "";
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--border-strong), transparent);
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 4rem;
  }
  .pager a {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 0.9rem 1.3rem 0.9rem 3.4rem;
    min-width: 200px;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--gold-bright);
    transition: border-color 0.2s, background 0.2s;
  }
  .pager a::before,
  .pager a::after {
    display: none;
  }
  .pager a:hover {
    border-color: rgba(255, 255, 255, 0.8);
    box-shadow: var(--select-glow);
  }
  .pager .prev {
    background:
      radial-gradient(circle at 1.7rem 50%, var(--slate) 0 0.95rem, transparent 1rem),
      var(--panel);
  }
  .pager .next {
    padding: 0.9rem 3.4rem 0.9rem 1.3rem;
    background:
      radial-gradient(circle at calc(100% - 1.7rem) 50%, var(--slate) 0 0.95rem, transparent 1rem),
      var(--panel);
  }
  .pager .prev span::before,
  .pager .next span::after {
    content: "";
    position: absolute;
    top: 50%;
    width: 0.5rem;
    height: 0.5rem;
    border: solid var(--gold-bright);
    border-width: 0 0 2px 2px;
  }
  .pager .prev span::before {
    left: 1.5rem;
    translate: 0 -50%;
    rotate: 45deg;
  }
  .pager .next span::after {
    right: 1.5rem;
    translate: 0 -50%;
    rotate: -135deg;
  }
  .pager span {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .pager .next {
    text-align: right;
    margin-left: auto;
  }
  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding-top: 1.5rem;
    }
    .sidebar details {
      position: static;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 0.8rem 1rem;
      background: var(--panel);
    }
    .sidebar summary {
      display: block;
      cursor: pointer;
      font-family: var(--font-display);
      font-weight: 700;
      color: var(--gold);
    }
    .sidebar nav {
      margin-top: 1rem;
    }
  }
</style>
