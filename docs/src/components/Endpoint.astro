---
interface Props {
  path: string;
  description?: string;
  method?: "GET" | "POST" | "DELETE";
}
const { path, description, method = "GET" } = Astro.props;
---

<div class="endpoint">
  <span class="method">{method}</span>
  <code class="path">{path}</code>
  {description && <span class="desc">{description}</span>}
</div>

<style>
  .endpoint {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 1rem;
    margin: 0.6rem 0;
    border: 1px solid var(--border);
    border-left: 3px solid var(--gold);
    border-radius: 8px 999px 999px 8px;
    background: linear-gradient(90deg, rgba(43, 50, 68, 0.9), rgba(43, 50, 68, 0.4));
  }
  .method {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--ink);
    background: var(--cream);
    border-radius: 999px;
    padding: 0.2em 0.8em;
  }
  .path {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--text);
    background: none;
    border: none;
    padding: 0;
  }
  .desc {
    margin-left: auto;
    color: var(--muted);
    font-size: 0.88rem;
  }
</style>
