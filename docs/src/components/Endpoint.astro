---
interface Props {
  path: string;
  description?: string;
}
const { path, description } = Astro.props;
---

<div class="endpoint">
  <span class="method">GET</span>
  <code class="path">{path}</code>
  {description && <span class="desc">{description}</span>}
</div>

<style>
  .endpoint {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 1rem;
    margin: 0.6rem 0;
    border: 1px solid var(--border);
    border-left: 3px solid var(--anemo);
    border-radius: 8px;
    background: rgba(116, 194, 168, 0.06);
  }
  .method {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #0c1a15;
    background: var(--anemo);
    border-radius: 4px;
    padding: 0.15em 0.55em;
  }
  .path {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--text);
    background: none;
    border: none;
    padding: 0;
  }
  .desc {
    margin-left: auto;
    color: var(--muted);
    font-size: 0.88rem;
  }
</style>
