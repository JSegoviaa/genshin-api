---
interface Props {
  size?: number;
}
const { size = 34 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  aria-hidden="true"
>
  <defs>
    <linearGradient id="logo-gold" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f6e7bd"></stop>
      <stop offset="1" stop-color="#b99b68"></stop>
    </linearGradient>
  </defs>
  <circle cx="24" cy="24" r="21" stroke="url(#logo-gold)" stroke-width="1.5"
  ></circle>
  <circle
    cx="24"
    cy="24"
    r="16.5"
    stroke="url(#logo-gold)"
    stroke-width="0.75"
    stroke-dasharray="2 3"></circle>
  <path
    d="M24 6 L27.2 20.8 L42 24 L27.2 27.2 L24 42 L20.8 27.2 L6 24 L20.8 20.8 Z"
    fill="url(#logo-gold)"></path>
  <path
    d="M24 15 L25.6 22.4 L33 24 L25.6 25.6 L24 33 L22.4 25.6 L15 24 L22.4 22.4 Z"
    fill="#10162a"
    transform="rotate(45 24 24)"></path>
  <circle cx="24" cy="24" r="2.2" fill="url(#logo-gold)"></circle>
</svg>
