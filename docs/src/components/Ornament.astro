---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={["ornament", className]} aria-hidden="true">
  <span class="line"></span>
  <span class="gem"></span>
  <span class="gem main"></span>
  <span class="gem"></span>
  <span class="line"></span>
</div>

<style>
  .ornament {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 2.5rem auto;
    max-width: 420px;
  }
  .line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold-deep));
  }
  .line:last-child {
    background: linear-gradient(90deg, var(--gold-deep), transparent);
  }
  .gem {
    width: 6px;
    height: 6px;
    transform: rotate(45deg);
    border: 1px solid var(--gold);
  }
  .gem.main {
    width: 22px;
    height: 22px;
    border: none;
    transform: none;
    background: var(--gold-bright);
    clip-path: polygon(50% 0, 60% 40%, 100% 50%, 60% 60%, 50% 100%, 40% 60%, 0 50%, 40% 40%);
    filter: drop-shadow(0 0 8px rgba(243, 226, 179, 0.9));
  }
</style>
