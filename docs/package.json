{
  "name": "genshin-api-docs",
  "version": "1.0.0",
  "description": "Documentation site for Genshin API",
  "scripts": {
    "dev": "npm --prefix .. run build:data && astro dev",
    "build": "npm --prefix .. run build:data && astro build",
