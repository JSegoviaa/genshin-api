    "check": "astro check",
    "deploy": "npm run build && wrangler deploy"
  },
  "type": "module",
  "private": "true",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "astro": "^7.4.9"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^6.0.3",
    "wrangler": "^4.160.0"
  }
}
